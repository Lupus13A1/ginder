# ==============================================================================
# GINDER (Flutter) .gitignore
# Complete specification for Flutter, Firebase, Android, iOS, Web, IDEs, and OS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Credentials (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
!.env.example

# Firebase configuration files (contains project API keys, App IDs, Client IDs)
**/firebase_options.dart
**/google-services.json
**/GoogleService-Info.plist
firebase.json
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Secret keys, Service accounts & Keystores
key.properties
key.jks
*.keystore
*.jks
*.p12
*.pem
*.key
*.cert
*.crt
service-account*.json
client_secret*.json

# ------------------------------------------------------------------------------
# 2. Flutter / Dart Build Artifacts & Caches
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
/build/
coverage/
**/doc/api/
*.symbols
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# 3. Android Platform Specific
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/local.properties
local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/app/build/
**/android/.cxx/
**/GeneratedPluginRegistrant.java
android/gradle/wrapper/gradle-wrapper.jar
android/captures/

# ------------------------------------------------------------------------------
# 4. iOS / macOS Platform Specific
# ------------------------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/flutter_assets/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Pods/
**/ios/.symlinks/
*.mode1v3
*.mode2v3
*.normal
*.perspectivev3
*.pbxuser
*.xcuserstate
xcuserdata/

# ------------------------------------------------------------------------------
# 5. IDE & Editor Files (Machine-Specific)
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/
!.vscode/settings.json.example

# JetBrains / Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse
.project
.classpath
.settings/

# ------------------------------------------------------------------------------
# 6. Operating System Specific
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 7. Temporary, Logs & Scratch Files
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*.pyc
* copy.*
* copy*
firebase_setup_guide copy.html
